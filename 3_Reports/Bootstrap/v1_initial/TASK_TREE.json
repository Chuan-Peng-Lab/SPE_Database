{
  "project": "Bootstrap Analysis for SPE in Mismatch Conditions",
  "objective": "Compute self-prioritization effect (Self vs. Stranger) in mismatch conditions with bootstrap resampling and sequential sample size augmentation",
  "output_path": "D:/GitHub_programe/GitHub/SPE_Database/3_Reports/Bootstrap",
  "data_source": "D:/GitHub_programe/GitHub/SPE_Database/1_Data/*_Clean.csv",
  "agents": {
    "planner": {
      "role": "Task decomposition and coordination",
      "responsibilities": [
        "Break down complex analysis into atomic tasks",
        "Define KPIs for each subtask",
        "Monitor progress and dependencies"
      ]
    },
    "executor": {
      "role": "Code execution and data processing",
      "responsibilities": [
        "Implement data loading pipeline",
        "Calculate Cohen's d values",
        "Execute bootstrap resampling",
        "Generate visualizations"
      ],
      "tools": ["Python", "pandas", "numpy", "scipy", "matplotlib", "seaborn"]
    },
    "researcher": {
      "role": "Literature review and methodology validation",
      "responsibilities": [
        "Verify statistical methods",
        "Provide references for bootstrap methodology",
        "Validate Cohen's d calculation"
      ]
    },
    "reviewer": {
      "role": "Quality assurance and validation",
      "responsibilities": [
        "Verify calculation accuracy",
        "Check visualization quality",
        "Validate statistical assumptions"
      ],
      "kpi": {
        "accuracy": "Cohen's d calculation matches expected values",
        "completeness": "All 4 figures generated successfully",
        "reproducibility": "Code runs from start to finish without errors"
      }
    }
  },
  "task_tree": {
    "phase_1": {
      "name": "Data Preparation",
      "tasks": [
        {
          "id": "1.1",
          "name": "Load and merge all Clean.csv files",
          "agent": "executor",
          "input": "52 *_Clean.csv files from 1_Data directory",
          "output": "merged_data.csv",
          "kpi": {
            "success_criteria": "All datasets loaded with correct column mapping",
            "verification": "Row count matches sum of individual files"
          }
        },
        {
          "id": "1.2",
          "name": "Data filtering and validation",
          "agent": "executor",
          "input": "merged_data.csv",
          "output": "filtered_data.csv",
          "kpi": {
            "success_criteria": "Only mismatch (Nonmatching) trials retained",
            "verification": "No Matching trials in output"
          }
        },
        {
          "id": "1.3",
          "name": "Create strict and loose filtering subsets",
          "agent": "executor",
          "input": "filtered_data.csv",
          "output": [
            "strict_filtered.csv (requires Shape+Label+3rd identity)",
            "loose_filtered.csv (requires Shape Self/Stranger only)"
          ],
          "kpi": {
            "success_criteria": "Both subsets correctly filtered",
            "verification": "strict subset has fewer rows than loose"
          }
        }
      ]
    },
    "phase_2": {
      "name": "Effect Size Calculation",
      "tasks": [
        {
          "id": "2.1",
          "name": "Calculate Cohen's d (Stranger-Self) per participant",
          "agent": "executor",
          "input": ["strict_filtered.csv", "loose_filtered.csv"],
          "output": "cohens_d_by_participant.csv",
          "formula": "Cohen's d = (Mean_RT_Stranger - Mean_RT_Self) / Pooled_SD",
          "kpi": {
            "success_criteria": "Each participant has d value for Shape and Label",
            "verification": "d values range typically -2 to 2"
          }
        },
        {
          "id": "2.2",
          "name": "Validate effect size calculations",
          "agent": "reviewer",
          "input": "cohens_d_by_participant.csv",
          "output": "validation_report.txt",
          "kpi": {
            "success_criteria": "Manual spot checks pass",
            "verification": "10 random participants verified"
          }
        }
      ]
    },
    "phase_3": {
      "name": "Bootstrap Resampling",
      "tasks": [
        {
          "id": "3.1",
          "name": "Implement sequential sample size augmentation with bootstrap",
          "agent": "executor",
          "input": "cohens_d_by_participant.csv",
          "output": "bootstrap_results.csv",
          "parameters": {
            "n_iterations": 1000,
            "sample_sizes": [10, 20, 30, ..., n_participants],
            "resampling_method": "with replacement"
          },
          "algorithm": [
            "1. Start with n=10 participants",
            "2. Bootstrap resample 1000 times",
            "3. Calculate mean Cohen's d and 95% CI for each iteration",
            "4. Increment sample size by 10",
            "5. Repeat until all participants included"
          ],
          "kpi": {
            "success_criteria": "Bootstrap converges as n increases",
            "verification": "CI width decreases with larger n"
          }
        },
        {
          "id": "3.2",
          "name": "Generate bootstrap summary statistics",
          "agent": "executor",
          "input": "bootstrap_results.csv",
          "output": "bootstrap_summary.csv",
          "kpi": {
            "success_criteria": "Mean, SD, 95% CI calculated for each sample size",
            "verification": "All statistics mathematically consistent"
          }
        }
      ]
    },
    "phase_4": {
      "name": "Visualization",
      "tasks": [
        {
          "id": "4.1",
          "name": "Generate Figure 1: Strict filtering - Shape baseline",
          "agent": "executor",
          "input": "bootstrap_summary.csv (strict)",
          "output": "figure1_shape_strict.png",
          "specifications": {
            "x_axis": "Sample Size",
            "y_axis": "Mean Cohen's d (Stranger-Self)",
            "error_bars": "95% CI",
            "reference_line": "y=0",
            "dpi": 300
          },
          "kpi": {
            "success_criteria": "Clear visualization of effect size vs sample size",
            "verification": "Figure matches description"
          }
        },
        {
          "id": "4.2",
          "name": "Generate Figure 2: Strict filtering - Label baseline",
          "agent": "executor",
          "input": "bootstrap_summary.csv (strict)",
          "output": "figure2_label_strict.png",
          "specifications": {
            "x_axis": "Sample Size",
            "y_axis": "Mean Cohen's d (Stranger-Self)",
            "error_bars": "95% CI",
            "reference_line": "y=0",
            "dpi": 300
          },
          "kpi": {
            "success_criteria": "Clear visualization of effect size vs sample size",
            "verification": "Figure matches description"
          }
        },
        {
          "id": "4.3",
          "name": "Generate Figure 3: Loose filtering - Shape baseline",
          "agent": "executor",
          "input": "bootstrap_summary.csv (loose)",
          "output": "figure3_shape_loose.png",
          "specifications": {
            "x_axis": "Sample Size",
            "y_axis": "Mean Cohen's d (Stranger-Self)",
            "error_bars": "95% CI",
            "reference_line": "y=0",
            "dpi": 300
          },
          "kpi": {
            "success_criteria": "Clear visualization of effect size vs sample size",
            "verification": "Figure matches description"
          }
        },
        {
          "id": "4.4",
          "name": "Generate Figure 4: Loose filtering - Label baseline",
          "agent": "executor",
          "input": "bootstrap_summary.csv (loose)",
          "output": "figure4_label_loose.png",
          "specifications": {
            "x_axis": "Sample Size",
            "y_axis": "Mean Cohen's d (Stranger-Self)",
            "error_bars": "95% CI",
            "reference_line": "y=0",
            "dpi": 300
          },
          "kpi": {
            "success_criteria": "Clear visualization of effect size vs sample size",
            "verification": "Figure matches description"
          }
        },
        {
          "id": "4.5",
          "name": "Combine 4 figures into final composite",
          "agent": "executor",
          "input": ["figure1.png", "figure2.png", "figure3.png", "figure4.png"],
          "output": "combined_figures_300dpi.png",
          "specifications": {
            "layout": "2x2 grid",
            "dpi": 300,
            "labels": ["A", "B", "C", "D"]
          },
          "kpi": {
            "success_criteria": "All 4 figures clearly visible in composite",
            "verification": "Final image is 300dpi"
          }
        }
      ]
    },
    "phase_5": {
      "name": "Documentation and Validation",
      "tasks": [
        {
          "id": "5.1",
          "name": "Generate analysis report",
          "agent": "executor",
          "input": "All intermediate results",
          "output": "analysis_report.md",
          "kpi": {
            "success_criteria": "Report includes methods, results, and interpretation",
            "verification": "All findings documented with sources"
          }
        },
        {
          "id": "5.2",
          "name": "Final quality review",
          "agent": "reviewer",
          "input": "All outputs",
          "output": "quality_review.txt",
          "kpi": {
            "success_criteria": "All KPIs met, no critical issues",
            "verification": "Reviewer sign-off"
          }
        }
      ]
    }
  },
  "dependencies": {
    "1.1 → 1.2 → 1.3": "Sequential data preparation",
    "1.3 → 2.1": "Effect size calculation depends on filtered data",
    "2.1 → 3.1 → 3.2": "Bootstrap depends on effect sizes",
    "3.2 → 4.1, 4.2, 4.3, 4.4": "Figures depend on bootstrap summary",
    "4.1, 4.2, 4.3, 4.4 → 4.5": "Combine after individual figures",
    "4.5 → 5.1 → 5.2": "Documentation and review after visualization"
  },
  "estimated_timeline": {
    "phase_1": "15 minutes",
    "phase_2": "10 minutes",
    "phase_3": "30 minutes",
    "phase_4": "20 minutes",
    "phase_5": "10 minutes",
    "total": "85 minutes"
  }
}
